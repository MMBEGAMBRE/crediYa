meta {
  name: 12 Salario en limite maximo (15000000)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Marta",
    "apellidos": "López",
    "fecha_nacimiento": "1985-06-30",
    "direccion": "Calle 10 # 20-30",
    "telefono": "3001234567",
    "correo_electronico": "{{correoNuevo}}",
    "salario_base": 15000000
  }
}

script:pre-request {
  // Correo único en cada envío para que siempre se pueda registrar
  bru.setVar("correoNuevo", "usuario" + Date.now() + "@crediya.com");
}

tests {
  test("responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("guarda salario 15000000", function() {
    expect(res.getBody().salario_base).to.equal(15000000);
  });
}
