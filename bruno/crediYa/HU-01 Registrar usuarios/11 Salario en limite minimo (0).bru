meta {
  name: 11 Salario en limite minimo (0)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Luis",
    "apellidos": "Pérez",
    "fecha_nacimiento": "1990-01-01",
    "direccion": "Calle 10 # 20-30",
    "telefono": "3001234567",
    "correo_electronico": "{{correoNuevo}}",
    "salario_base": 0
  }
}

script:pre-request {
  // Correo único en cada envío para que siempre se pueda registrar
  bru.setVar("correoNuevo", "usuario" + Date.now() + "@crediya.com");
}

tests {
  test("responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("guarda salario 0", function() {
    expect(res.getBody().salario_base).to.equal(0);
  });
}
