meta {
  name: 05 Correo con formato invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Ana",
    "apellidos": "Gómez",
    "fecha_nacimiento": "1995-04-12",
    "direccion": "Calle 10 # 20-30",
    "telefono": "3001234567",
    "correo_electronico": "ana@",
    "salario_base": 3500000
  }
}

tests {
  test("responde 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("mensaje: correo_electronico no tiene un formato válido", function() {
    expect(res.getBody().mensaje).to.include("correo_electronico no tiene un formato válido");
  });
}
