meta {
  name: 08 Salario no numerico
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Ana",
    "apellidos": "Gómez",
    "fecha_nacimiento": "1995-04-12",
    "direccion": "Calle 10 # 20-30",
    "telefono": "3001234567",
    "correo_electronico": "{{correoNuevo}}",
    "salario_base": "abc"
  }
}

script:pre-request {
  // Correo único en cada envío para que siempre se pueda registrar
  bru.setVar("correoNuevo", "usuario" + Date.now() + "@crediya.com");
}

tests {
  test("responde 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("mensaje: salario_base debe ser numérico", function() {
    expect(res.getBody().mensaje).to.include("salario_base debe ser numérico");
  });
}
